# From the app registration leihs-calendar-sync in Microsoft Entra.
# The tenant must be the GUID. The secret is the "Value" column, not "Secret ID".
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=change-me

# Calendar of each mailbox that receives the events. It is created if it does
# not exist. Empty: the main calendar of the mailbox.
CALENDAR_NAME=Reservas leihs

# Reservation statuses that become events, from: submitted, approved, signed, closed.
SYNC_STATUSES=approved,signed,closed

# true: the person who made the reservation gets an invitation from the
# mailbox, and the updates and cancellation when it changes.
INVITE_BOOKER=false

TIME_ZONE=Europe/Madrid
SYNC_INTERVAL_SECONDS=60

# The database settings come from /etc/leihs/config.env (DB_PORT, DB_NAME,
# DB_USER, DB_PASSWORD), which the service file also loads.

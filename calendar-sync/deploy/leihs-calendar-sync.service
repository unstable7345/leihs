[Unit]
Description=leihs reservations to Outlook calendars
After=network-online.target leihs-migration.service
Wants=network-online.target

[Service]
User=leihs-calendar-sync
WorkingDirectory=/opt/leihs-calendar-sync
# Database settings of leihs, then the ones of this service.
EnvironmentFile=/etc/leihs/config.env
EnvironmentFile=/etc/leihs-calendar-sync/env
# Must be a Node 22+ this user can read: not one inside a person's home directory.
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

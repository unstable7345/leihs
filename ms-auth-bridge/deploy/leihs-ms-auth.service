[Unit]
Description=leihs Microsoft sign-in bridge
After=network-online.target
Wants=network-online.target

[Service]
User=leihs-ms-auth
WorkingDirectory=/opt/leihs-ms-auth
EnvironmentFile=/etc/leihs-ms-auth/env
# Must be a Node 22+ this user can read: not one inside a person's home directory.
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Public address of this service, as the browser sees it
PUBLIC_URL=https://leihs.enti.cat/ms-auth
LEIHS_BASE_URL=https://leihs.enti.cat

# From the app registration in Microsoft Entra. The tenant must be the GUID.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=change-me

# ID token claim that must match the user's email in leihs.
# preferred_username is the UPN for work accounts. Avoid "email" unless TI
# confirms users cannot change it: it is not a verified value in Entra.
MS_IDENTITY_CLAIM=preferred_username

# Created by scripts/generate-keys.sh
SIGNING_PRIVATE_KEY_FILE=/etc/leihs-ms-auth/private.pem

PORT=3999
